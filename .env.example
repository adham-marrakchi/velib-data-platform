# =============================================================
# Vélib' Data Platform — configuration locale (copier en .env)
# Les valeurs ci-dessous sont des secrets de DÉVELOPPEMENT uniquement.
# =============================================================

# ===========================
# POSTGRESQL (warehouse + métadonnées)
# ===========================
POSTGRES_USER=velib
POSTGRES_PASSWORD=velib_secret_2026
POSTGRES_DB=velib_dw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Bases de métadonnées des outils (créées par scripts/postgres/init.sh)
AIRFLOW_DB=airflow
MLFLOW_DB=mlflow
SUPERSET_DB=superset
# Rôles en lecture seule sur le schéma gold
GOLD_READER_USER=gold_reader
GOLD_READER_PASSWORD=gold_reader_2026
ASSISTANT_DB_USER=assistant_ro
ASSISTANT_DB_PASSWORD=assistant_ro_2026

# ===========================
# SOURCE : VÉLIB' MÉTROPOLE (GBFS, open data)
# ===========================
VELIB_GBFS_BASE_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole
VELIB_POLL_INTERVAL_SECONDS=60
VELIB_HTTP_TIMEOUT_SECONDS=20
# true = ne publie que les stations dont last_reported a changé (réduit le volume ~10x)
VELIB_ONLY_CHANGED=true

# ===========================
# KAFKA (KRaft, sans ZooKeeper)
# ===========================
KAFKA_BROKER=kafka:29092
KAFKA_TOPIC=velib_status
KAFKA_CLUSTER_ID=VlbDtPltfrm2026Kraft01

# ===========================
# MINIO / S3 (data lake Delta)
# ===========================
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_secret_2026
MINIO_ENDPOINT=http://minio:9000
LAKE_BUCKET=lake
MLFLOW_BUCKET=mlflow

# ===========================
# AIRFLOW
# ===========================
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_2026
AIRFLOW_FERNET_KEY=LQxv3F0XrJ327R_XtvkX5pyq08PegLbYlvJpYphnXaQ=
AIRFLOW_JWT_SECRET=change_me_with_openssl_rand_base64_32

# ===========================
# SPARK
# ===========================
SPARK_STREAMING_MASTER=local[2]
SPARK_DRIVER_MEMORY=768m

# ===========================
# MLFLOW
# ===========================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=velib_bikes_1h
PSI_THRESHOLD=0.2

# ===========================
# SUPERSET
# ===========================
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin_2026
SUPERSET_SECRET_KEY=change_me_superset_dev_secret_2026

# ===========================
# MONITORING
# ===========================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=admin_2026

# ===========================
# ASSISTANT IA (chatbot, service "assistant" : http://localhost:8090)
# ===========================
# Clé OpenRouter (https://openrouter.ai/settings/keys). Ne jamais la committer : .env est ignoré par git.
OPENROUTER_API_KEY=
# Modèles compatibles avec les outils, par ordre de préférence (séparés par des virgules) :
# si l'un est saturé, le suivant prend le relais. Les modèles ":free" sont limités à 50 requêtes/jour.
OPENROUTER_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free

# ===========================
# ALERTES (toutes optionnelles : vide = alerte seulement en base + logs)
# ===========================
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FRESHNESS_THRESHOLD_MINUTES=10
